#!/usr/bin/env bash

set -euo pipefail

# =============================================================================
# NOMAD WALLPAPER
# =============================================================================

VERBOSE=0

for arg in "$@"; do
  case "$arg" in
    -v|--verbose) VERBOSE=1 ;;
    -h|--help)
      echo "Usage: nomad-wallpaper [-v|--verbose] [-h|--help]"
      exit 0
      ;;
    *)
      echo "error: unknown argument: $arg" >&2
      exit 1
      ;;
  esac
done

# =============================================================================
# CONFIGURACIÓN
# =============================================================================

WALLPAPER_DIR="$(xdg-user-dir PICTURES 2>/dev/null || echo "$HOME/Pictures")/Wallpapers"

STATE_DIR="$HOME/.local/share/nomad-wallpaper"

# Imágenes pendientes de la vuelta actual, en el orden en que se mostrarán
PLAYLIST="$STATE_DIR/playlist.txt"

# Imágenes ya mostradas en la vuelta actual
SEEN="$STATE_DIR/seen.txt"

# Última imagen aplicada (evita repetirla al empezar una vuelta nueva)
LAST="$STATE_DIR/last"

# Formato de estado anterior a v1.4.0 (índice sobre playlist.txt)
LEGACY_CURRENT="$STATE_DIR/current"

LOCK_FILE="$STATE_DIR/lock"

LOG_FILE="$STATE_DIR/nomad.log"

# Modo de ajuste: fill | fit | center | tile | stretch | none
WALLPAPER_MODE="fill"

# Se detecta automáticamente, pero puede sobrescribirse
SCREEN_RES=""

# Configuración del usuario (sobrevive a reinstalaciones)
CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/nomad-wallpaper/config"

# shellcheck source=/dev/null
[[ -f "$CONFIG_FILE" ]] && source "$CONFIG_FILE"

PENDING=()
SEEN_LIST=()
AVAILABLE=()

# =============================================================================
# FUNCIONES
# =============================================================================
log() {
  [[ "$VERBOSE" -eq 0 ]] && return
  mkdir -p "$STATE_DIR"
  printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >>"$LOG_FILE"
}

get_screen_resolution() {

  [[ -n "$SCREEN_RES" ]] && return

  local geometry

  geometry=$(xrandr --current 2>/dev/null | grep primary | grep -oP '\d+x\d+')
  [[ -z "$geometry" ]] && geometry=$(xrandr --current 2>/dev/null | grep -m1 connected | grep -oP '\d+x\d+')
  [[ -z "$geometry" ]] && geometry=$(xdpyinfo 2>/dev/null | grep dimensions | grep -oP '\d+x\d+')

  if [[ -z "$geometry" ]]; then
    echo "warning: could not detect screen resolution" >&2
    log "warning: could not detect screen resolution"
    return 1
  fi

  SCREEN_RES="$geometry"
  log "detected screen resolution: $SCREEN_RES"

}

process_image() {

  local src="$1"
  local dst="$2"
  local mode="$3"
  local w="${SCREEN_RES%x*}"
  local h="${SCREEN_RES#*x}"

  case "$mode" in
    fill)
      magick "$src" -resize "${w}x${h}^" -gravity center -extent "${w}x${h}" "$dst"
      ;;
    fit)
      magick "$src" -resize "${w}x${h}" -background black -gravity center -extent "${w}x${h}" "$dst"
      ;;
    center)
      magick "$src" -background black -gravity center -extent "${w}x${h}" "$dst"
      ;;
    tile)
      magick "$src" -write mpr:tile +delete -size "${w}x${h}" tile:mpr:tile "$dst"
      ;;
    stretch)
      magick "$src" -resize "${w}x${h}!" "$dst"
      ;;
    none)
      return 1
      ;;
  esac

}

scan_wallpapers() {

  find "$WALLPAPER_DIR" \
    -maxdepth 1 \
    -type f \
    \( \
    -iname "*.jpg" \
    -o -iname "*.jpeg" \
    -o -iname "*.png" \
    -o -iname "*.webp" \
    \) |
    LC_ALL=C sort

}

read_list() {

  local -n out="$1"
  local file="$2"

  out=()
  [[ -f "$file" ]] && mapfile -t out <"$file"
  return 0

}

write_list() {

  local file="$1"
  shift

  if (($#)); then
    printf '%s\n' "$@" >"$file.tmp"
  else
    : >"$file.tmp"
  fi

  mv -f "$file.tmp" "$file"

}

migrate_legacy_state() {

  [[ -f "$LEGACY_CURRENT" ]] || return 0

  local line
  local -a all=()

  line=$(<"$LEGACY_CURRENT")
  [[ "$line" =~ ^[0-9]+$ ]] && ((line >= 1)) || line=1

  if [[ -f "$PLAYLIST" ]]; then
    mapfile -t all <"$PLAYLIST"
    write_list "$SEEN" "${all[@]:0:line-1}"
    write_list "$PLAYLIST" "${all[@]:line-1}"
    ((line >= 2)) && ((line - 2 < ${#all[@]})) && printf '%s\n' "${all[line-2]}" >"$LAST"
  fi

  rm -f "$LEGACY_CURRENT"

  log "migrated legacy state (current=$line)"

}

start_cycle() {

  local last=""

  mapfile -t PENDING < <(printf '%s\n' "${AVAILABLE[@]}" | shuf)
  SEEN_LIST=()

  [[ -f "$LAST" ]] && last=$(<"$LAST")

  # No empezar la vuelta con la misma imagen con la que acabó la anterior
  if ((${#PENDING[@]} > 1)) && [[ "${PENDING[0]}" == "$last" ]]; then
    PENDING=("${PENDING[@]:1}" "${PENDING[0]}")
  fi

  log "new cycle started with ${#PENDING[@]} entries"

}

sync_playlist() {

  local f
  local pos
  local removed=0
  local added=0
  local -A in_dir=()
  local -A known=()
  local -a kept=()

  mapfile -t AVAILABLE < <(scan_wallpapers)

  if ((${#AVAILABLE[@]} == 0)); then
    echo "error: no wallpapers found in $WALLPAPER_DIR" >&2
    log "error: no wallpapers found in $WALLPAPER_DIR"
    exit 1
  fi

  for f in "${AVAILABLE[@]}"; do
    in_dir["$f"]=1
  done

  read_list PENDING "$PLAYLIST"
  read_list SEEN_LIST "$SEEN"

  # Descartar imágenes que ya no existen (y duplicados)
  for f in "${PENDING[@]}"; do
    if [[ -n "$f" && -n "${in_dir["$f"]:-}" && -z "${known["$f"]:-}" ]]; then
      kept+=("$f")
      known["$f"]=1
    else
      ((++removed))
    fi
  done
  PENDING=("${kept[@]}")

  kept=()
  for f in "${SEEN_LIST[@]}"; do
    if [[ -n "$f" && -n "${in_dir["$f"]:-}" && -z "${known["$f"]:-}" ]]; then
      kept+=("$f")
      known["$f"]=1
    else
      ((++removed))
    fi
  done
  SEEN_LIST=("${kept[@]}")

  # Insertar las imágenes nuevas en posiciones aleatorias de las pendientes
  for f in "${AVAILABLE[@]}"; do
    [[ -n "${known["$f"]:-}" ]] && continue
    pos=$((RANDOM % (${#PENDING[@]} + 1)))
    PENDING=("${PENDING[@]:0:pos}" "$f" "${PENDING[@]:pos}")
    ((++added))
  done

  ((removed)) && log "removed $removed missing entries"
  ((added)) && log "added $added new wallpapers"

  ((${#PENDING[@]})) || start_cycle

  write_list "$PLAYLIST" "${PENDING[@]}"
  write_list "$SEEN" "${SEEN_LIST[@]}"

  log "playlist: ${#PENDING[@]} pending, ${#SEEN_LIST[@]} seen"

}

processed_path() {

  printf '%s/processed-%s.jpg' "$STATE_DIR" "$(printf '%s' "$1" | sha256sum | cut -c1-12)"

}

set_wallpaper() {

  local image="$1"
  local target="$image"

  if [[ -n "$SCREEN_RES" ]] && [[ "$WALLPAPER_MODE" != "none" ]]; then
    local processed
    processed=$(processed_path "$image")
    if process_image "$image" "$processed" "$WALLPAPER_MODE"; then
      target="$processed"
    fi
  fi

  plasma-apply-wallpaperimage "$target" >/dev/null || return 1
  log "wallpaper applied: $target"

  # Conservar solo la imagen procesada en uso
  local f
  for f in "$STATE_DIR"/processed-*.jpg; do
    [[ -e "$f" && "$f" != "$target" ]] && rm -f "$f"
  done

  return 0

}

mark_as_seen() {

  local image="$1"

  PENDING=("${PENDING[@]:1}")
  SEEN_LIST+=("$image")

  write_list "$PLAYLIST" "${PENDING[@]}"
  write_list "$SEEN" "${SEEN_LIST[@]}"
  printf '%s\n' "$image" >"$LAST"

}

initialize() {

  if [[ ! -d "$WALLPAPER_DIR" ]]; then
    echo "error: wallpaper directory not found: $WALLPAPER_DIR" >&2
    log "error: wallpaper directory not found: $WALLPAPER_DIR"
    exit 1
  fi

  case "$WALLPAPER_MODE" in
    fill | fit | center | tile | stretch | none) ;;
    *)
      echo "warning: unknown WALLPAPER_MODE '$WALLPAPER_MODE', falling back to fill" >&2
      log "warning: unknown WALLPAPER_MODE '$WALLPAPER_MODE', using fill"
      WALLPAPER_MODE="fill"
      ;;
  esac

  if [[ "$WALLPAPER_MODE" != "none" ]] && ! command -v magick &>/dev/null; then
    echo "warning: ImageMagick (magick) not found, falling back to mode=none" >&2
    log "warning: ImageMagick not found, using mode=none"
    WALLPAPER_MODE="none"
  fi

  mkdir -p "$STATE_DIR"

  # Evitar ejecuciones simultáneas (timer + ejecución manual)
  exec 9>"$LOCK_FILE"
  if ! flock -n 9; then
    log "another instance is running, exiting"
    exit 0
  fi

  migrate_legacy_state

  log "initialized (mode=$WALLPAPER_MODE, dir=$WALLPAPER_DIR)"

}

main() {

  log "--- run start ---"
  initialize

  get_screen_resolution || true

  sync_playlist

  local image="${PENDING[0]}"

  # Si no se puede aplicar (p. ej. sin sesión de Plasma), no se consume la imagen
  if ! set_wallpaper "$image"; then
    echo "error: could not apply wallpaper: $image" >&2
    log "error: could not apply wallpaper: $image"
    exit 1
  fi

  mark_as_seen "$image"

  log "--- run end ---"

}

# =============================================================================
# PROGRAMA PRINCIPAL
# =============================================================================

main
