#!/usr/bin/env bash

set -euo pipefail

# =============================================================================
# NOMAD WALLPAPER
# =============================================================================

VERBOSE=0
COMMAND="run"
SHOW_ALL=0

usage() {
  cat <<'EOF_USAGE'
Usage: nomad-wallpaper [-v|--verbose]          apply the next wallpaper
       nomad-wallpaper status [-a|--all]       show the rotation state (read-only)
       nomad-wallpaper -h|--help

  -v, --verbose   append timestamped entries to the log file
  -a, --all       with status: list every image with the mode it will use
EOF_USAGE
}

for arg in "$@"; do
  case "$arg" in
    status) COMMAND="status" ;;
    -a|--all) SHOW_ALL=1 ;;
    -v|--verbose) VERBOSE=1 ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "error: unknown argument: $arg" >&2
      usage >&2
      exit 1
      ;;
  esac
done

if ((SHOW_ALL)) && [[ "$COMMAND" != "status" ]]; then
  echo "error: --all is only valid with status" >&2
  exit 1
fi

# =============================================================================
# CONFIGURACIÓN
# =============================================================================

WALLPAPER_DIR="$(xdg-user-dir PICTURES 2>/dev/null || echo "$HOME/Pictures")/Wallpapers"

STATE_DIR="$HOME/.local/share/nomad-wallpaper"

# Imágenes pendientes de la vuelta actual, en el orden en que se mostrarán
PLAYLIST="$STATE_DIR/playlist.txt"

# Imágenes ya mostradas en la vuelta actual
SEEN="$STATE_DIR/seen.txt"

# Última imagen aplicada (evita repetirla al empezar una vuelta nueva)
LAST="$STATE_DIR/last"

# Formato de estado anterior a v1.4.0 (índice sobre playlist.txt)
LEGACY_CURRENT="$STATE_DIR/current"

LOCK_FILE="$STATE_DIR/lock"

LOG_FILE="$STATE_DIR/nomad.log"

# Modo de ajuste: auto | fill | fit | blur | pad | center | tile | stretch | none
WALLPAPER_MODE="auto"

# auto: recorte máximo (%) que se acepta para usar fill
AUTO_MAX_CROP=25

# blur/pad/auto: ampliación máxima (%) de la imagen
MAX_UPSCALE=150

# Se detecta automáticamente, pero puede sobrescribirse
SCREEN_RES=""

# Configuración del usuario (sobrevive a reinstalaciones)
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/nomad-wallpaper"
CONFIG_FILE="$CONFIG_DIR/config"

# Modo por imagen: líneas "<modo> <patrón>" sobre el nombre del archivo
OVERRIDES_FILE="$CONFIG_DIR/overrides"

# shellcheck source=/dev/null
[[ -f "$CONFIG_FILE" ]] && source "$CONFIG_FILE"

HAVE_MAGICK=0

AUTO_MODE=""
AUTO_DETAIL=""

PENDING=()
SEEN_LIST=()
AVAILABLE=()

# =============================================================================
# FUNCIONES
# =============================================================================
log() {
  [[ "$VERBOSE" -eq 0 ]] && return
  mkdir -p "$STATE_DIR"
  printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >>"$LOG_FILE"
}

get_screen_resolution() {

  [[ -n "$SCREEN_RES" ]] && return

  local geometry

  geometry=$(xrandr --current 2>/dev/null | grep primary | grep -oP '\d+x\d+')
  [[ -z "$geometry" ]] && geometry=$(xrandr --current 2>/dev/null | grep -m1 connected | grep -oP '\d+x\d+')
  [[ -z "$geometry" ]] && geometry=$(xdpyinfo 2>/dev/null | grep dimensions | grep -oP '\d+x\d+')

  if [[ -z "$geometry" ]]; then
    echo "warning: could not detect screen resolution" >&2
    log "warning: could not detect screen resolution"
    return 1
  fi

  SCREEN_RES="$geometry"
  log "detected screen resolution: $SCREEN_RES"

}

is_valid_mode() {

  case "$1" in
    auto | fill | fit | blur | pad | center | tile | stretch | none) return 0 ;;
    *) return 1 ;;
  esac

}

override_mode() {

  local name="$1"
  local mode
  local pattern

  [[ -f "$OVERRIDES_FILE" ]] || return 0

  while read -r mode pattern; do
    [[ -z "$mode" || "$mode" == \#* || -z "$pattern" ]] && continue
    # shellcheck disable=SC2053
    [[ "$name" == $pattern ]] || continue
    if is_valid_mode "$mode"; then
      printf '%s' "$mode"
      return 0
    fi
    log "warning: invalid mode '$mode' in $OVERRIDES_FILE, ignored"
  done <"$OVERRIDES_FILE"

}

# Imprime "<uniforme 0|1> <color hex>" de una franja de los cuatro bordes
analyze_edges() {

  magick "$1[0]" -resize 100x100! -write mpr:img +delete \
    \( mpr:img -crop 100x3+0+0 \) \
    \( mpr:img -crop 100x3+0+97 \) \
    \( mpr:img -crop 3x100+0+0 -rotate 90 \) \
    \( mpr:img -crop 3x100+97+0 -rotate 90 \) \
    +repage -append \
    -format '%[fx:standard_deviation<0.03?1:0] ' -write info:- \
    -scale 1x1! -format '%[hex:p{0,0}]' info:-

}

# Decide fill, pad o blur según tamaño, proporción y bordes de la imagen.
# Deja el resultado en AUTO_MODE y el motivo en AUTO_DETAIL.
resolve_auto_mode() {

  local src="$1"
  local sw="${SCREEN_RES%x*}"
  local sh="${SCREEN_RES#*x}"
  local dims edges iw ih a b uniform color

  dims=$(magick identify -ping -format '%w %h' "$src[0]") || return 1
  read -r iw ih <<<"$dims"

  # Proporciones comparadas como productos cruzados (sin decimales)
  a=$((iw * sh))
  b=$((sw * ih))
  ((a < b)) && read -r a b <<<"$b $a"

  local small=0
  ((100 * sw > MAX_UPSCALE * iw || 100 * sh > MAX_UPSCALE * ih)) && small=1

  if ((!small && 100 * b >= (100 - AUTO_MAX_CROP) * a)); then
    AUTO_MODE="fill"
    AUTO_DETAIL="${iw}x${ih}"
    return 0
  fi

  edges=$(analyze_edges "$src") || return 1
  read -r uniform color <<<"$edges"
  AUTO_DETAIL="${iw}x${ih}, small=$small, uniform_edges=$uniform"

  if ((uniform)); then
    AUTO_MODE="pad:#$color"
  else
    AUTO_MODE="blur"
  fi

}

# Encaja la imagen entera (ampliando como máximo MAX_UPSCALE) sobre un fondo
render_fit() {

  local src="$1"
  local dst="$2"
  local background="$3"
  local w="${SCREEN_RES%x*}"
  local h="${SCREEN_RES#*x}"
  local dims iw ih scale scale_h

  dims=$(magick identify -ping -format '%w %h' "$src[0]") || return 1
  read -r iw ih <<<"$dims"

  scale=$((100 * w / iw))
  scale_h=$((100 * h / ih))
  ((scale_h < scale)) && scale=$scale_h
  ((scale > MAX_UPSCALE)) && scale=$MAX_UPSCALE

  if [[ "$background" == "blur" ]]; then
    magick "$src[0]" \
      \( -clone 0 -resize "${w}x${h}^" -gravity center -extent "${w}x${h}" \
      -scale 10% -blur 0x3 -resize "${w}x${h}!" -fill black -colorize 35% \) \
      \( -clone 0 -resize "${scale}%" \) \
      -delete 0 -gravity center -composite "$dst"
  else
    magick "$src[0]" -resize "${scale}%" -background "$background" \
      -gravity center -extent "${w}x${h}" "$dst"
  fi

}

process_image() {

  local src="$1"
  local dst="$2"
  local mode="$3"
  local w="${SCREEN_RES%x*}"
  local h="${SCREEN_RES#*x}"
  local color=""

  if [[ "$mode" == "auto" ]]; then
    resolve_auto_mode "$src" || return 1
    mode="$AUTO_MODE"
    log "auto mode: $mode ($AUTO_DETAIL)"
  fi

  if [[ "$mode" == pad:* ]]; then
    color="${mode#pad:}"
    mode="pad"
  fi

  case "$mode" in
    fill)
      magick "$src" -resize "${w}x${h}^" -gravity center -extent "${w}x${h}" "$dst"
      ;;
    fit)
      magick "$src" -resize "${w}x${h}" -background black -gravity center -extent "${w}x${h}" "$dst"
      ;;
    blur)
      render_fit "$src" "$dst" blur
      ;;
    pad)
      if [[ -z "$color" ]]; then
        local edges uniform
        edges=$(analyze_edges "$src") || return 1
        read -r uniform color <<<"$edges"
        color="#$color"
      fi
      render_fit "$src" "$dst" "$color"
      ;;
    center)
      magick "$src" -background black -gravity center -extent "${w}x${h}" "$dst"
      ;;
    tile)
      magick "$src" -write mpr:tile +delete -size "${w}x${h}" tile:mpr:tile "$dst"
      ;;
    stretch)
      magick "$src" -resize "${w}x${h}!" "$dst"
      ;;
    *)
      return 1
      ;;
  esac

}

scan_wallpapers() {

  find "$WALLPAPER_DIR" \
    -maxdepth 1 \
    -type f \
    \( \
    -iname "*.jpg" \
    -o -iname "*.jpeg" \
    -o -iname "*.png" \
    -o -iname "*.webp" \
    \) |
    LC_ALL=C sort

}

read_list() {

  local -n out="$1"
  local file="$2"

  out=()
  [[ -f "$file" ]] && mapfile -t out <"$file"
  return 0

}

write_list() {

  local file="$1"
  shift

  if (($#)); then
    printf '%s\n' "$@" >"$file.tmp"
  else
    : >"$file.tmp"
  fi

  mv -f "$file.tmp" "$file"

}

migrate_legacy_state() {

  [[ -f "$LEGACY_CURRENT" ]] || return 0

  local line
  local -a all=()

  line=$(<"$LEGACY_CURRENT")
  [[ "$line" =~ ^[0-9]+$ ]] && ((line >= 1)) || line=1

  if [[ -f "$PLAYLIST" ]]; then
    mapfile -t all <"$PLAYLIST"
    write_list "$SEEN" "${all[@]:0:line-1}"
    write_list "$PLAYLIST" "${all[@]:line-1}"
    ((line >= 2)) && ((line - 2 < ${#all[@]})) && printf '%s\n' "${all[line-2]}" >"$LAST"
  fi

  rm -f "$LEGACY_CURRENT"

  log "migrated legacy state (current=$line)"

}

start_cycle() {

  local last=""

  mapfile -t PENDING < <(printf '%s\n' "${AVAILABLE[@]}" | shuf)
  SEEN_LIST=()

  [[ -f "$LAST" ]] && last=$(<"$LAST")

  # No empezar la vuelta con la misma imagen con la que acabó la anterior
  if ((${#PENDING[@]} > 1)) && [[ "${PENDING[0]}" == "$last" ]]; then
    PENDING=("${PENDING[@]:1}" "${PENDING[0]}")
  fi

  log "new cycle started with ${#PENDING[@]} entries"

}

sync_playlist() {

  local f
  local pos
  local removed=0
  local added=0
  local -A in_dir=()
  local -A known=()
  local -a kept=()

  mapfile -t AVAILABLE < <(scan_wallpapers)

  if ((${#AVAILABLE[@]} == 0)); then
    echo "error: no wallpapers found in $WALLPAPER_DIR" >&2
    log "error: no wallpapers found in $WALLPAPER_DIR"
    exit 1
  fi

  for f in "${AVAILABLE[@]}"; do
    in_dir["$f"]=1
  done

  read_list PENDING "$PLAYLIST"
  read_list SEEN_LIST "$SEEN"

  # Descartar imágenes que ya no existen (y duplicados)
  for f in "${PENDING[@]}"; do
    if [[ -n "$f" && -n "${in_dir["$f"]:-}" && -z "${known["$f"]:-}" ]]; then
      kept+=("$f")
      known["$f"]=1
    else
      ((++removed))
    fi
  done
  PENDING=("${kept[@]}")

  kept=()
  for f in "${SEEN_LIST[@]}"; do
    if [[ -n "$f" && -n "${in_dir["$f"]:-}" && -z "${known["$f"]:-}" ]]; then
      kept+=("$f")
      known["$f"]=1
    else
      ((++removed))
    fi
  done
  SEEN_LIST=("${kept[@]}")

  # Insertar las imágenes nuevas en posiciones aleatorias de las pendientes
  for f in "${AVAILABLE[@]}"; do
    [[ -n "${known["$f"]:-}" ]] && continue
    pos=$((RANDOM % (${#PENDING[@]} + 1)))
    PENDING=("${PENDING[@]:0:pos}" "$f" "${PENDING[@]:pos}")
    ((++added))
  done

  ((removed)) && log "removed $removed missing entries"
  ((added)) && log "added $added new wallpapers"

  ((${#PENDING[@]})) || start_cycle

  write_list "$PLAYLIST" "${PENDING[@]}"
  write_list "$SEEN" "${SEEN_LIST[@]}"

  log "playlist: ${#PENDING[@]} pending, ${#SEEN_LIST[@]} seen"

}

processed_path() {

  printf '%s/processed-%s.jpg' "$STATE_DIR" "$(printf '%s' "$1" | sha256sum | cut -c1-12)"

}

set_wallpaper() {

  local image="$1"
  local target="$image"
  local mode

  mode=$(override_mode "${image##*/}")
  if [[ -n "$mode" ]]; then
    log "override for ${image##*/}: $mode"
  else
    mode="$WALLPAPER_MODE"
  fi

  if [[ -n "$SCREEN_RES" ]] && [[ "$mode" != "none" ]] && ((HAVE_MAGICK)); then
    local processed
    processed=$(processed_path "$image")
    if process_image "$image" "$processed" "$mode"; then
      target="$processed"
    else
      log "warning: could not process image (mode=$mode), applying original"
    fi
  fi

  plasma-apply-wallpaperimage "$target" >/dev/null || return 1
  log "wallpaper applied: $target"

  # Conservar solo la imagen procesada en uso
  local f
  for f in "$STATE_DIR"/processed-*.jpg; do
    [[ -e "$f" && "$f" != "$target" ]] && rm -f "$f"
  done

  return 0

}

mark_as_seen() {

  local image="$1"

  PENDING=("${PENDING[@]:1}")
  SEEN_LIST+=("$image")

  write_list "$PLAYLIST" "${PENDING[@]}"
  write_list "$SEEN" "${SEEN_LIST[@]}"
  printf '%s\n' "$image" >"$LAST"

}

validate_settings() {

  if ! is_valid_mode "$WALLPAPER_MODE"; then
    echo "warning: unknown WALLPAPER_MODE '$WALLPAPER_MODE', falling back to auto" >&2
    log "warning: unknown WALLPAPER_MODE '$WALLPAPER_MODE', using auto"
    WALLPAPER_MODE="auto"
  fi

  if [[ ! "$AUTO_MAX_CROP" =~ ^[0-9]+$ ]] || ((AUTO_MAX_CROP > 100)); then
    log "warning: invalid AUTO_MAX_CROP '$AUTO_MAX_CROP', using 25"
    AUTO_MAX_CROP=25
  fi

  if [[ ! "$MAX_UPSCALE" =~ ^[0-9]+$ ]] || ((MAX_UPSCALE < 1)); then
    log "warning: invalid MAX_UPSCALE '$MAX_UPSCALE', using 150"
    MAX_UPSCALE=150
  fi

  if command -v magick &>/dev/null; then
    HAVE_MAGICK=1
  elif [[ "$WALLPAPER_MODE" != "none" ]]; then
    echo "warning: ImageMagick (magick) not found, falling back to mode=none" >&2
    log "warning: ImageMagick not found, using mode=none"
    WALLPAPER_MODE="none"
  fi

}

initialize() {

  if [[ ! -d "$WALLPAPER_DIR" ]]; then
    echo "error: wallpaper directory not found: $WALLPAPER_DIR" >&2
    log "error: wallpaper directory not found: $WALLPAPER_DIR"
    exit 1
  fi

  validate_settings

  mkdir -p "$STATE_DIR"

  # Evitar ejecuciones simultáneas (timer + ejecución manual)
  exec 9>"$LOCK_FILE"
  if ! flock -n 9; then
    log "another instance is running, exiting"
    exit 0
  fi

  migrate_legacy_state

  log "initialized (mode=$WALLPAPER_MODE, dir=$WALLPAPER_DIR)"

}

main() {

  log "--- run start ---"
  initialize

  get_screen_resolution || true

  sync_playlist

  local image="${PENDING[0]}"

  # Si no se puede aplicar (p. ej. sin sesión de Plasma), no se consume la imagen
  if ! set_wallpaper "$image"; then
    echo "error: could not apply wallpaper: $image" >&2
    log "error: could not apply wallpaper: $image"
    exit 1
  fi

  mark_as_seen "$image"

  log "--- run end ---"

}

# Modo efectivo de una imagen, tal como lo aplicaría set_wallpaper
describe_mode() {

  local image="$1"
  local mode
  local suffix=""

  mode=$(override_mode "${image##*/}")
  if [[ -n "$mode" ]]; then
    suffix=" (override)"
  else
    mode="$WALLPAPER_MODE"
  fi

  if [[ -z "$SCREEN_RES" ]] || ((!HAVE_MAGICK)); then
    mode="none"
  elif [[ "$mode" == "auto" ]]; then
    if resolve_auto_mode "$image"; then
      mode="${AUTO_MODE%%:*}"
    else
      mode="auto?"
    fi
  fi

  printf '%s%s' "$mode" "$suffix"

}

status() {

  local f
  local mode
  local pos=0
  local new=0
  local missing=0
  local last=""
  local next_image=""
  local next_run=""
  local rules=0
  local -a pending=()
  local -a seen=()
  local -a available=()
  local -A in_dir=()
  local -A known=()
  local -A mode_count=()

  validate_settings
  get_screen_resolution 2>/dev/null || true

  [[ -d "$WALLPAPER_DIR" ]] && mapfile -t available < <(scan_wallpapers)
  read_list pending "$PLAYLIST"
  read_list seen "$SEEN"
  [[ -f "$LAST" ]] && last=$(<"$LAST")

  for f in "${available[@]}"; do
    in_dir["$f"]=1
  done

  for f in "${pending[@]}" "${seen[@]}"; do
    [[ -n "$f" ]] || continue
    known["$f"]=1
    [[ -n "${in_dir["$f"]:-}" ]] || ((++missing))
  done

  for f in "${available[@]}"; do
    [[ -n "${known["$f"]:-}" ]] || ((++new))
  done

  for f in "${pending[@]}"; do
    if [[ -n "${in_dir["$f"]:-}" ]]; then
      next_image="$f"
      break
    fi
  done

  [[ -f "$OVERRIDES_FILE" ]] && rules=$(grep -cvE '^[[:space:]]*(#|$)' "$OVERRIDES_FILE" || true)

  if command -v systemctl &>/dev/null &&
    [[ "$(systemctl --user show nomad-wallpaper.timer -p ActiveState --value 2>/dev/null)" == "active" ]]; then
    next_run=$(systemctl --user show nomad-wallpaper.timer -p NextElapseUSecRealtime --value 2>/dev/null)
  fi

  echo "Nomad Wallpaper status"
  echo ""

  if [[ -d "$WALLPAPER_DIR" ]]; then
    printf '  %-12s %s (%d images)\n' "Directory:" "$WALLPAPER_DIR" "${#available[@]}"
  else
    printf '  %-12s %s (not found)\n' "Directory:" "$WALLPAPER_DIR"
  fi

  if [[ "$WALLPAPER_MODE" == "auto" ]]; then
    printf '  %-12s auto (max crop %d%%, max upscale %d%%)\n' "Mode:" "$AUTO_MAX_CROP" "$MAX_UPSCALE"
  else
    printf '  %-12s %s\n' "Mode:" "$WALLPAPER_MODE"
  fi

  printf '  %-12s %d rule(s) in %s\n' "Overrides:" "$rules" "$OVERRIDES_FILE"

  printf '  %-12s %s\n' "Resolution:" "${SCREEN_RES:-unknown}"

  if ((${#pending[@]} + ${#seen[@]} == 0)); then
    printf '  %-12s %s\n' "Cycle:" "not started yet"
  else
    printf '  %-12s %d/%d shown, %d pending\n' "Cycle:" \
      "${#seen[@]}" "$((${#seen[@]} + ${#pending[@]}))" "${#pending[@]}"
  fi

  if [[ -n "$last" ]]; then
    printf '  %-12s %s\n' "Current:" "${last##*/}"
  else
    printf '  %-12s %s\n' "Current:" "none"
  fi
  if [[ -n "$next_image" ]]; then
    printf '  %-12s %s\n' "Next:" "${next_image##*/}"
  else
    printf '  %-12s %s\n' "Next:" "new cycle on next run"
  fi
  printf '  %-12s %s\n' "Next change:" "${next_run:-timer inactive}"

  if ((new || missing)); then
    printf '  %-12s %d new, %d missing (synced on next run)\n' "Sync:" "$new" "$missing"
  fi

  ((SHOW_ALL)) || return 0

  echo ""
  echo "Images (in order of appearance):"
  echo ""

  for f in "${pending[@]}"; do
    [[ -n "${in_dir["$f"]:-}" ]] || continue
    mode=$(describe_mode "$f")
    mode_count["${mode% (override)}"]=$((${mode_count["${mode% (override)}"]:-0} + 1))
    printf '  %4d  %-16s %s\n' "$((++pos))" "$mode" "${f##*/}"
  done

  for f in "${available[@]}"; do
    [[ -n "${known["$f"]:-}" ]] && continue
    mode=$(describe_mode "$f")
    mode_count["${mode% (override)}"]=$((${mode_count["${mode% (override)}"]:-0} + 1))
    printf '  %4s  %-16s %s\n' "new" "$mode" "${f##*/}"
  done

  for f in "${seen[@]}"; do
    [[ -n "${in_dir["$f"]:-}" ]] || continue
    mode=$(describe_mode "$f")
    mode_count["${mode% (override)}"]=$((${mode_count["${mode% (override)}"]:-0} + 1))
    printf '  %4s  %-16s %s\n' "seen" "$mode" "${f##*/}"
  done

  echo ""
  printf '  %s:' "By mode"
  for mode in "${!mode_count[@]}"; do
    printf ' %s=%d' "$mode" "${mode_count[$mode]}"
  done
  echo ""

}

# =============================================================================
# PROGRAMA PRINCIPAL
# =============================================================================

case "$COMMAND" in
  status) status ;;
  *) main ;;
esac
